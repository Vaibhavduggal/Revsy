{
  "name": "review-bot",
  "private": true,
  "workspaces": [
    "client/",
    "server/"
  ],
  "scripts": {
    "bootstrap": "npm install --workspace=client && npm install --workspace=server",
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "screenshots:marketing": "npm run build && node scripts/screenshots-marketing.mjs",
    "screenshots:ux": "npm run build && node scripts/screenshots-ux.mjs",
    "start:local": "npm run build && node server/src/server.js",
    "test:local": "echo 'Run: npm install && npm run dev, then visit http://localhost:4000'"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
