{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/.*|assets/.*).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/sends", "schedule": "* * * * *" },
    { "path": "/api/cron/weekly", "schedule": "0 2 * * 1" }
  ]
}
