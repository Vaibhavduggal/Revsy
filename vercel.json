{
  "version": 2,
  "framework": "next",
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/next",
      "config": {
        "command": "build",
        "cwd": "."
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://YOUR_BACKEND_URL"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}