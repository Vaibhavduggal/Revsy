# Copy to server/.env for local development, and set the same keys in Vercel.

# Required — Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Required — Google Business Profile OAuth
# Production: https://YOUR_DOMAIN/api/auth/google/callback (must match Google Cloud Console)
# If unset or set to localhost, the server derives the redirect from the incoming request host.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/google/callback
FRONTEND_URL=https://YOUR_DOMAIN

# Platform owner login (server-side only)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI — Gemini first, Groq fallback
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cron (required on Vercel — set Authorization: Bearer <CRON_SECRET> on cron jobs)
CRON_SECRET=

# Security / access model
# Production defaults to invite-only sign-up. Set open only for public registration.
SIGNUP_MODE=invite_only
FRONTEND_URL=https://YOUR_DOMAIN
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
INBOUND_WEBHOOK_SECRET=
# ENABLE_RESET_DB=true   # local dev only — enables POST /api/reset-db
